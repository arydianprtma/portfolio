// This is your Prisma schema file configured for Supabase (PostgreSQL),
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id            String   @id @default(cuid())
  slug          String   @unique
  number        String
  title         String
  subtitle      String
  subtitleId    String?  @db.Text
  description   String   @db.Text
  descriptionId String?  @db.Text
  overview      String?  @db.Text
  overviewId    String?  @db.Text
  category      String
  year          Int
  technologies  String   @db.Text // Stored as JSON string
  thumbnail     String   @db.Text
  images        String?  @db.Text // Stored as JSON string
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  github        String?  @db.Text
  demo          String?  @db.Text
  role          String?
  roleId        String?
  features      String?  @db.Text // Stored as JSON string
  challenges    String?  @db.Text // Stored as JSON string
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  titleId     String?
  summary     String   @db.Text
  summaryId   String?  @db.Text
  content     String   @db.Text
  contentId   String?  @db.Text
  coverImage  String?  @db.Text
  tags        String   @db.Text // Stored as JSON string array
  readingTime String   @default("4 min read")
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  budget    String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Profile {
  id         String   @id @default("profile_default")
  name       String
  moniker    String
  role       String
  roleId     String?
  tagline    String
  taglineId  String?
  bio        String   @db.Text // Stored as JSON string array
  bioId      String?  @db.Text // Stored as JSON string array
  location   String
  status     String
  statusId   String?
  email      String
  avatarUrl  String?  @db.Text
  resumeUrl  String?  @db.Text
  socials    String   @db.Text // Stored as JSON string object
  updatedAt  DateTime @updatedAt
}

model SkillCategory {
  id     String @id @default(cuid())
  title  String
  skills String @db.Text // Stored as JSON string array
  order  Int    @default(0)
}

model Experiment {
  id           String  @id
  title        String
  category     String
  description  String  @db.Text
  year         Int
  technologies String  @db.Text // Stored as JSON string array
  link         String? @db.Text
  github       String? @db.Text
}

model Admin {
  id                String   @id @default("admin_default")
  email             String   @unique
  password          String
  twoFactorSecret   String?  @db.Text
  twoFactorEnabled  Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

model Analytics {
  id          String   @id @default("analytics_default")
  pageViews   Int      @default(0)
  cvDownloads Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Invoice {
  id             String   @id @default(cuid())
  invoiceNumber  String   @unique
  clientName     String
  clientEmail    String?
  clientAddress  String?  @db.Text
  clientPhone    String?
  status         String   @default("PENDING") // DRAFT, PENDING, PAID, CANCELLED
  issueDate      DateTime @default(now())
  dueDate        DateTime
  currency       String   @default("IDR") // IDR, USD
  items          String   @db.Text // Stored as JSON string of InvoiceItem[]
  subtotal       Float    @default(0)
  taxPercent     Float?   @default(0)
  taxAmount      Float?   @default(0)
  discountAmount Float?   @default(0)
  total          Float    @default(0)
  paymentDetails String?  @db.Text
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

